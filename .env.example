MAIL_DOMAIN=mailtemps.space
API_ADDR=:8081
SMTP_ADDR=:2525
DATABASE_URL=postgres://mailtemps:change-this-password@postgres:5432/mailtemps?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
INBOX_TTL=10m
MAX_INBOX_TTL=30m
CLEANUP_INTERVAL=1m
MAX_MESSAGE_BYTES=10485760
CREATE_RATE_LIMIT=10
CREATE_RATE_WINDOW=1m
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEur9TakuO4XajKU
TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://100.99.104.45:3001,https://mailtemps.space

# Pengiriman keluar (direct-to-MX).
OUTBOUND_ENABLED=true
HELO_HOSTNAME=mx.mailtemps.space
DKIM_SELECTOR=mail
# Kunci privat RSA (PEM) dalam base64 satu baris. Kosong = kirim tanpa DKIM.
DKIM_PRIVATE_KEY_B64=
SEND_PER_INBOX_LIMIT=5
SEND_GLOBAL_DAILY_LIMIT=50
SEND_TIMEOUT=20s

POSTGRES_DB=mailtemps
POSTGRES_USER=mailtemps
POSTGRES_PASSWORD=change-this-password
WEB_PORT=3001
API_PORT=8081
SMTP_BIND_IP=127.0.0.1
SMTP_PUBLIC_PORT=2525
